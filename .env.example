SMARTAPI_API_KEY=
SMARTAPI_CLIENT_ID=
SMARTAPI_PIN=
SMARTAPI_TOTP_SECRET=
ADMIN_USERNAME=admin
# Use a bcrypt hash in production. Generate one with:
# python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD=
SESSION_SECRET_KEY=replace-with-a-long-random-secret
SECURE_COOKIES=false
DEFAULT_STRATEGY_NAME=V5.1

# Keep false until you have tested with your exact Angel One account and symbols.
SMARTAPI_LIVE_TRADING=false

QUANTITY_LOTS=1
BANKNIFTY_LOT_SIZE=35
BANKNIFTY_SPOT_EXCHANGE=NSE
BANKNIFTY_SPOT_SYMBOL=Nifty Bank
BANKNIFTY_SPOT_TOKEN=99926009
SMARTAPI_PRODUCT_TYPE=INTRADAY
SMARTAPI_ORDER_VARIETY=NORMAL
LOG_LEVEL=INFO

# --- Option-chain archive -----------------------------------------------------
# Snapshots open interest, IV, volume, LTP and spot every few minutes into a
# SEPARATE database file. Collection only: nothing live reads it, and it needs
# months of history before it can be evaluated. It is on by default because
# chain history cannot be backfilled -- Angel serves none, so the archive can
# only ever start from the day it starts.
OPTION_CHAIN_COLLECTION_ENABLED=true
OPTION_CHAIN_STRIKE_BAND=10
OPTION_CHAIN_EXPIRY_COUNT=2
OPTION_CHAIN_INTERVAL_MINUTES=5
# Grows without bound by design (~500 MB/year at the defaults). Point this at a
# roomier volume if data/ is tight. Never the trading database.
# OPTION_CHAIN_DB_PATH=data/option_chain.db

# OPTIONAL second Angel One API key, used ONLY by the chain collector.
# Angel rate-limits per API key, so this is the only way to give analysis work a
# budget that genuinely cannot starve live trading -- a second session on the
# SAME key shares the same quota and merely drops the process-wide throttle.
# Left blank, the collector shares the live budget and yields to it instead.
SMARTAPI_ANALYTICS_API_KEY=
SMARTAPI_ANALYTICS_CLIENT_ID=
SMARTAPI_ANALYTICS_PIN=
SMARTAPI_ANALYTICS_TOTP_SECRET=
